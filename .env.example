# Variables de docker-compose.yml. Copiar a .env antes de levantar: cp .env.example .env
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# .env lo lee Compose, no dotnet run. Para .NET exportar en la shell o usar user-secrets:
# export ConnectionStrings__Default="Host=localhost;Port=5432;Database=platform;Username=platform;Password=change-me-local"
